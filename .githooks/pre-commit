#!/bin/sh
# Phase 0.6 — gates are re-run, not assumed.
#
# The full gate suite is the LAST thing that runs before a commit, after every
# file including docs, with nothing edited after it. A prior pass appended to
# RELEASE.md after its final gate run and shipped a red banned-vocabulary gate
# as a result — caught only by the next session, by accident. This hook makes
# the re-run mechanical instead of a habit: a commit that would ship a red gate
# is refused here.
#
# Activate once per clone (not tracked by git):  git config core.hooksPath .githooks
# Bypass in a genuine emergency only:            git commit --no-verify

echo "pre-commit: running npm run gates …"
if ! npm run --silent gates; then
  echo
  echo "pre-commit: gates FAILED — commit refused. Fix the red gate, then commit."
  echo "            (last resort, discouraged: git commit --no-verify)"
  exit 1
fi
echo "pre-commit: gates green."
exit 0
