{
  "name": "diction-dash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DICTION DASH — endless word-gate runner: read fast, pick right, outrun the pursuit.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "gates": "node tools/gates.mjs && node tools/word-gates.mjs && node tools/corruption-gates.mjs && node tools/meta-gates.mjs && node tools/family-gate.mjs && node tools/music-gates.mjs && node tools/reachability-gate.mjs && node tools/refactor-snapshot.mjs && node tools/calibration-gates.mjs",
    "gate:p1": "node tools/gates.mjs p1",
    "gate:p2": "node tools/gates.mjs p2",
    "gate:p3": "node tools/gates.mjs p3",
    "gate:p4": "node tools/gates.mjs p4",
    "gate:v1": "node tools/v1-gates.mjs && node tools/v1-polish-gates.mjs && node tools/v1-pwa-gates.mjs",
    "audio:list": "node tools/generate-elevenlabs-audio.mjs --list",
    "audio:generate": "node tools/generate-elevenlabs-audio.mjs",
    "gate:words": "node tools/word-gates.mjs",
    "gate:corruption": "node tools/corruption-gates.mjs",
    "gate:family": "node tools/family-gate.mjs",
    "gate:music": "node tools/music-gates.mjs",
    "build:scoremap": "node tools/build-score-map.mjs",
    "build:family": "node tools/build-family-blocklist.mjs",
    "calibrate:speed": "node tools/speed-calibration.mjs",
    "audit:size": "node tools/build-report.mjs",
    "audit:network": "node tools/network-audit.mjs",
    "build:definitions": "node tools/build-definitions.mjs",
    "feel": "node tools/feel-measure.mjs",
    "calibrate": "node tools/calibration-gates.mjs --emit && node tools/refactor-snapshot.mjs --emit"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "an-array-of-english-words": "^2.0.0",
    "vite": "^5.4.10",
    "wordnet-db": "^3.1.14"
  }
}
